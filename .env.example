# Public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Private server key from the SAME Supabase project (starts with sb_secret_).
# A publishable key here will not work, even if the variable is named SECRET_KEY.
# Local: set in .env.local. Netlify: Production context, Functions scope, then redeploy.
# Never prefix this variable with NEXT_PUBLIC_ or commit its actual value.
SUPABASE_SECRET_KEY=
